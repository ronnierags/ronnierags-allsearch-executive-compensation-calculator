modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
ADMIN_EMAIL = "rragusa@allsearchinc.com"
EMAIL_FROM = "rragusa@allsearchinc.com"
LEAD_NOTIFICATION_EMAIL = "rragusa@allsearchinc.com"

[nix]
channel = "stable-25_05"
